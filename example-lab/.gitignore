# kit/ and .claude/ are installed by `make example` and are not part of what this example commits.
# kit/ must stay un-ignored: pages link into the shell, and the link check treats a gitignored
# target as missing from every other clone.
.claude/
content/catalog.json
content/search-index.json
content/backlinks.json
content/chronicle.json
content/ladder.json
content/*/*/nav.json
dist/
.serve.pid
.serve.log
__pycache__/
*.pyc
